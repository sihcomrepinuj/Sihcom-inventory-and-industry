{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "build": {
      "inputs": [
        {"step": "install"},
        {"local": true, "include": ["."]}
      ],
      "commands": [
        "SDE_FORCE_REFRESH=1 python setup_sde.py"
      ]
    }
  },
  "deploy": {
    "inputs": [
      "...",
      {"step": "build", "include": ["data"]}
    ]
  }
}
